# ==========================================
# Dependency directories
# ==========================================
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
*.env
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example

# ==========================================
# Build & Distribution Artifacts
# ==========================================
dist/
dist-ssr/
build/
client/dist/
server/dist/
*.tsbuildinfo

# ==========================================
# User Uploads & Media
# ==========================================
server/uploads/*
!server/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ==========================================
# Scratch / Debug Scripts
# ==========================================
server/test_api.js
server/scratch_test.js
*.local

# ==========================================
# Editor & IDE Directories
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ==========================================
# OS System Files
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
