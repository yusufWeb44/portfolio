# ===================================================================
# SERVER ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and configure all variables securely.
# NEVER commit your real .env file with secrets into version control!
# ===================================================================

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Port
PORT=5000

# Production Database URI (e.g. MySQL, PostgreSQL)
DATABASE_URL="mysql://db_user:strong_password@localhost:3306/portfolio_db"

# JWT Secret Key: MUST be a cryptographically strong random string (min 32 chars)
# Generate using: openssl rand -base64 48
JWT_SECRET="replace-with-a-64-character-random-hex-string-before-deployment"

# Allowed Client Origin for Strict CORS (e.g. https://yourdomain.com)
CLIENT_URL="http://localhost:5173"

# Uploads Storage Directory (Legacy local disk)
UPLOAD_DIR="uploads"

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Twilio SMS 2FA Authentication (Production SMS Gateway)
# Obtain these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Optional: Default Admin Mobile Phone Destination
# ADMIN_MOBILE_NUMBER="+905550000000"

# Optional: Cloudflare Turnstile Secret Key (Server-Side)
# TURNSTILE_SECRET_KEY="0x4AAAAAA..."
