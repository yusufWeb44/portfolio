# ===================================================================
# CLIENT ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env or .env.production and provide production URLs.
# Never commit .env or .env.production to version control!
# ===================================================================

# Backend API Base Endpoint (e.g. https://api.yourdomain.com/api)
VITE_API_URL=http://localhost:5000/api

# Backend Static Assets & Uploads Base URL (e.g. https://api.yourdomain.com)
VITE_UPLOADS_URL=http://localhost:5000

# Optional: Cloudflare Turnstile CAPTCHA Site Key (Public)
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...
